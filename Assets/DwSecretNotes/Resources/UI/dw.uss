:root { --sp-1: 4px; --sp-2: 8px; --sp-3: 12px; --sp-4: 16px; --sp-5: 24px; --sp-6: 32px; --sp-7: 48px; --rad-xs: 4px; --rad-sm: 8px; --rad-md: 12px; --rad-lg: 16px; --rad-xl: 24px; --rad-full: 9999px; }
.dw-root Label, .dw-root TextElement, .dw-root Button, .dw-root TextField { -unity-text-generator: advanced; }
.dw-focus-ring { position: absolute; left: -2px; top: -2px; right: -2px; bottom: -2px; border-width: 2px; border-radius: var(--rad-sm); display: none; }
.dw-focus-ring--visible { display: flex; }
.dw-root { flex-grow: 1; font-size: 15px; -unity-text-generator: advanced; }
.dw-reduced-motion, .dw-reduced-motion * { transition-duration: 0ms; }
.dw-root Label { white-space: normal; }
.dw-aurora { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
.dw-aurora__blob { position: absolute; left: 0; top: 0; }
.dw-safe { flex-grow: 1; }
.dw-pagehost { flex-grow: 1; }
.dw-page { flex-grow: 1; transition-property: opacity, translate; transition-duration: 320ms, 320ms; transition-timing-function: ease-out-cubic, ease-out-cubic; }
.dw-enter { opacity: 0; translate: 0 18px; }
.dw-section { transition-property: opacity, translate; transition-duration: 300ms; transition-timing-function: ease-out-cubic; }
.dw-fade-out { opacity: 0; }
.dw-hero__ad { transition-property: opacity; transition-duration: 300ms; min-height: 42px; }
.dw-row { flex-direction: row; align-items: center; }
.dw-rtl .dw-row { flex-direction: row-reverse; }
.dw-rtl Label { -unity-text-align: upper-right; }
.dw-col { flex-direction: column; }
.dw-scroll { flex-grow: 1; }
.dw-scroll__content { padding: var(--sp-4) var(--sp-4) var(--sp-5) var(--sp-4); }
.dw-gap-row > * { margin-right: var(--sp-2); }
.dw-rtl .dw-gap-row > * { margin-right: 0; margin-left: var(--sp-2); }

.dw-topbar { height: 60px; padding: 0 var(--sp-2) 0 var(--sp-2); border-bottom-width: 1px; flex-shrink: 0; }
.dw-topbar__logo { width: 34px; height: 34px; border-radius: var(--rad-md); margin: 0 var(--sp-2) 0 var(--sp-1); -unity-background-scale-mode: scale-to-fit; }
.dw-topbar__title { font-size: 19px; -unity-font-style: bold; -unity-text-overflow-position: end; text-overflow: ellipsis; white-space: nowrap; overflow: hidden; }
.dw-iconbtn { width: 44px; height: 44px; border-radius: var(--rad-full); align-items: center; justify-content: center; transition-property: background-color, scale; transition-duration: 150ms; }
.dw-iconbtn:hover { background-color: rgba(255,255,255,0.06); }
.dw-iconbtn:active { scale: 0.9 0.9; background-color: rgba(255,255,255,0.12); }

.dw-h1 { font-size: 26px; -unity-font-style: bold; }
.dw-h2 { font-size: 20px; -unity-font-style: bold; }
.dw-title { font-size: 17px; -unity-font-style: bold; }
.dw-body { font-size: 15px; }
.dw-small { font-size: 13px; }
.dw-caption { font-size: 12px; -unity-text-align: upper-center; }
.dw-bold { -unity-font-style: bold; }
.dw-overline { font-size: 11px; -unity-font-style: bold; letter-spacing: 1.5px; margin-bottom: var(--sp-1); }
.dw-label { font-size: 14px; -unity-font-style: bold; }
.dw-link { font-size: 14px; -unity-text-align: upper-center; margin-bottom: var(--sp-1); }
.dw-secret { font-size: 18px; margin-bottom: var(--sp-2); }

.dw-card { border-radius: var(--rad-xl); border-width: 1px; padding: var(--sp-4); }
.dw-hero { padding: var(--sp-4); }
.dw-hero__badge { width: 64px; height: 64px; border-radius: var(--rad-xl); border-width: 1px; align-items: center; justify-content: center; margin-right: var(--sp-3); flex-shrink: 0; }
.dw-rtl .dw-hero__badge { margin-right: 0; margin-left: var(--sp-3); }
.dw-hero__glow { position: absolute; left: -30px; top: -30px; width: 124px; height: 124px; }

.dw-tabs { height: 52px; border-radius: var(--rad-xl); border-width: 1px; padding: var(--sp-1); }
.dw-tabs__indicator { position: absolute; top: 4px; bottom: 4px; left: 4px; width: 50%; border-radius: 20px; transition-property: translate; transition-duration: 280ms; transition-timing-function: ease-out-back; }
.dw-tabs__indicator--right { translate: 96% 0; }
.dw-rtl .dw-tabs__indicator { translate: 96% 0; }
.dw-rtl .dw-tabs__indicator--right { translate: 0 0; }
.dw-tab { flex-grow: 1; flex-basis: 0; height: 100%; justify-content: center; border-radius: 20px; }
.dw-tab__text { font-size: 15px; -unity-font-style: bold; margin-left: var(--sp-2); }
.dw-rtl .dw-tab__text { margin-left: 0; margin-right: var(--sp-2); }

.dw-btn { height: 50px; border-radius: var(--rad-lg); padding: 0 var(--sp-4) 0 var(--sp-4); justify-content: center; border-width: 1px; transition-property: scale, opacity; transition-duration: 120ms, 200ms; -unity-background-scale-mode: stretch-to-fill; overflow: hidden; flex-shrink: 0; }
.dw-btn:hover { opacity: 0.94; }
.dw-btn:active { scale: 0.97 0.97; }
.dw-btn:disabled { opacity: 0.38; }
.dw-btn--busy { opacity: 0.85; }
.dw-btn--lg { height: 56px; border-radius: var(--rad-lg); }
.dw-btn--square { width: 50px; padding: 0; }
.dw-btn__text { font-size: 16px; -unity-font-style: bold; margin-left: var(--sp-2); white-space: nowrap; text-overflow: ellipsis; overflow: hidden; flex-shrink: 1; }
.dw-rtl .dw-btn__text { margin-left: 0; margin-right: var(--sp-2); }
.dw-btn > Spinner, .dw-btn > .dw-icon { flex-shrink: 0; }
.dw-btn--donate { padding: 0 var(--sp-2) 0 var(--sp-2); min-width: 0; }
.dw-btn--donate .dw-btn__text { font-size: 14px; margin-left: var(--sp-1); }
.dw-rtl .dw-btn--donate .dw-btn__text { margin-left: 0; margin-right: var(--sp-1); }


.dw-field { flex-direction: column; border-radius: var(--rad-lg); border-width: 1px; min-height: 52px; padding: var(--sp-1) var(--sp-1) var(--sp-1) var(--sp-1); transition-property: border-color; transition-duration: 200ms; }
.dw-field--focus { border-width: 2px; padding: var(--sp-1) var(--sp-1) var(--sp-1) var(--sp-1); }
.dw-field__input { margin: 0; flex-grow: 1; min-width: 0; }
.dw-field__input > .unity-base-text-field__input, .dw-field__input .unity-base-text-field__input { background-color: rgba(0,0,0,0); border-width: 0; padding: var(--sp-2) var(--sp-2) var(--sp-2) var(--sp-2); font-size: 16px; min-height: 40px; }
.dw-field__input--multi .unity-base-text-field__input { max-height: 150px; white-space: normal; }
.dw-field__input--multi TextElement { white-space: normal; }
.dw-field__placeholder { position: absolute; left: 14px; right: 14px; top: 14px; font-size: 16px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
.dw-field__actions { flex-direction: row; justify-content: flex-end; flex-shrink: 0; }
.dw-field__action { width: 44px; min-width: 44px; min-height: 44px; padding: 0; align-items: center; justify-content: center; border-radius: var(--rad-md); border-width: 1px; }
.dw-field__action:focus { border-width: 2px; }

.dw-attachrow > .dw-btn { margin-right: var(--sp-2); }
.dw-thumb { width: 56px; height: 56px; flex-shrink: 0; margin-left: var(--sp-2); transition-property: opacity, translate; transition-duration: 250ms; }
.dw-thumb__img { width: 56px; height: 56px; border-radius: var(--rad-md); -unity-background-scale-mode: scale-and-crop; }
.dw-thumb__remove { position: absolute; right: -10px; top: -10px; width: 44px; height: 44px; min-width: 44px; min-height: 44px; padding: var(--sp-1); border-radius: var(--rad-full); align-items: center; justify-content: center; }

.dw-banner { border-radius: var(--rad-lg); border-width: 1px; padding: var(--sp-2) var(--sp-3) var(--sp-2) var(--sp-3); transition-property: opacity, translate; transition-duration: 250ms; }
.dw-banner__text { font-size: 14px; margin-left: var(--sp-2); flex-shrink: 1; }
.dw-rtl .dw-banner__text { margin-left: 0; margin-right: var(--sp-2); }
.dw-linkpill { border-radius: var(--rad-lg); border-width: 1px; padding: var(--sp-3); }
.dw-linkpill__text { font-size: 14px; margin-left: var(--sp-2); white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
.dw-divider { height: 1px; margin: var(--sp-3) 0 var(--sp-3) 0; flex-shrink: 0; }
.dw-decimage { border-radius: var(--rad-lg); height: 220px; -unity-background-scale-mode: scale-to-fit; margin-bottom: var(--sp-1); display: none; }
.dw-ring__value { font-size: 17px; -unity-font-style: bold; -unity-text-align: middle-center; }

.dw-footer { align-items: center; padding: var(--sp-2) 0 var(--sp-2) 0; }
.dw-footer__rate { align-items: center; }
.dw-stars { margin-top: var(--sp-1); }
.dw-star { margin: 0 var(--sp-1) 0 var(--sp-1); transition-property: scale; transition-duration: 120ms; }
.dw-star:active { scale: 1.25 1.25; }
.dw-stars.disabled { opacity: 0.5; }

.dw-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.dw-scrim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; transition-property: opacity; transition-duration: 240ms; }
.dw-scrim--hidden { opacity: 0; }
.dw-sheethost { position: absolute; left: 0; right: 0; bottom: 0; top: 0; justify-content: flex-end; }
.dw-dialoghost { position: absolute; left: 0; right: 0; bottom: 0; top: 0; justify-content: center; align-items: center; padding: var(--sp-5); }
.dw-sheet { width: 100%; max-width: 720px; align-self: center; border-top-left-radius: 26px; border-top-right-radius: 26px; padding: var(--sp-2) var(--sp-4) var(--sp-5) var(--sp-4); max-height: 85%; transition-property: translate, opacity; transition-duration: 280ms; transition-timing-function: ease-out-cubic; }
.dw-sheet__handle { width: 40px; height: 4px; border-radius: var(--rad-full); align-self: center; margin-bottom: var(--sp-3); }
.dw-sheet__scroll { max-height: 520px; flex-shrink: 1; }
.dw-dialog { border-radius: var(--rad-xl); border-width: 1px; padding: var(--sp-5); width: 100%; max-width: 440px; transition-property: scale, opacity; transition-duration: 220ms; transition-timing-function: ease-out-back; }
.dw-dialog__actions { justify-content: flex-end; flex-wrap: wrap; }
.dw-dialog__actions > .dw-btn { margin-left: var(--sp-2); margin-top: var(--sp-1); }
.dw-panel--hidden { opacity: 0; }
.dw-sheet.dw-panel--hidden { translate: 0 100%; }
.dw-dialog.dw-panel--hidden { scale: 0.92 0.92; }
.dw-viewer { position: absolute; left: -24px; right: -24px; top: -24px; bottom: -24px; padding: 0; border-radius: 0; max-width: none; border-width: 0; }
.dw-viewer__img { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; margin: var(--sp-5); transform-origin: center center; transition-property: scale, translate; transition-duration: 100ms; }
.dw-viewer__close { position: absolute; right: 36px; top: 48px; background-color: rgba(0,0,0,0.35); }
.dw-menuitem { height: 54px; padding: 0 var(--sp-2) 0 var(--sp-2); border-radius: var(--rad-lg); }
.dw-menuitem:hover { background-color: rgba(255,255,255,0.05); }
.dw-menuitem:active { background-color: rgba(255,255,255,0.1); }
.dw-menuitem__text { font-size: 16px; margin-left: var(--sp-4); }
.dw-rtl .dw-menuitem__text { margin-left: 0; margin-right: var(--sp-4); }
.dw-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.dw-swatch { width: 48.5%; margin-bottom: var(--sp-2); border-radius: var(--rad-lg); border-width: 1px; overflow: hidden; transition-property: scale; transition-duration: 120ms; }
.dw-swatch:active { scale: 0.96 0.96; }
.dw-swatch--selected { border-width: 2px; }
.dw-swatch:hover .dw-icon { display: flex; opacity: 0.5; }
.dw-swatch--selected .dw-icon { opacity: 1; }
.dw-swatch__bar { height: 46px; }
.dw-swatch__label { padding: var(--sp-2); }

.dw-toasthost { position: absolute; left: 16px; right: 16px; bottom: 24px; align-items: center; }
.dw-toast { border-radius: var(--rad-lg); border-width: 1px; padding: var(--sp-3) var(--sp-4) var(--sp-3) var(--sp-4); max-width: 520px; margin-top: var(--sp-2); transition-property: opacity, translate; transition-duration: 260ms; transition-timing-function: ease-out-cubic; }
.dw-toast--hidden { opacity: 0; translate: 0 20px; }
.dw-toast--shift { translate: 0 10px; }
.dw-toast__text { font-size: 14px; }

.dw-pagehead { padding: var(--sp-5) var(--sp-4) var(--sp-3) var(--sp-4); flex-shrink: 0; }
.dw-welcome__logo { width: 76px; height: 76px; border-radius: var(--rad-xl); margin-bottom: var(--sp-4); -unity-background-scale-mode: scale-to-fit; }
.dw-infohead { align-items: center; padding-top: var(--sp-2); }
.dw-langitem { border-radius: var(--rad-lg); border-width: 1px; padding: var(--sp-3) var(--sp-4) var(--sp-3) var(--sp-4); margin-bottom: var(--sp-2); transition-property: scale, background-color; transition-duration: 140ms; }
.dw-langitem:active { scale: 0.98 0.98; }
.dw-langitem .dw-title { flex-shrink: 1; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
.dw-bottombar { padding: var(--sp-3) var(--sp-4) var(--sp-4) var(--sp-4); flex-shrink: 0; }
.dw-inforow { padding: var(--sp-1) 0 var(--sp-1) 0; }
.dw-accordion__body { display: none; margin-top: var(--sp-2); }
.dw-accordion--open .dw-accordion__body { display: flex; }
.dw-accordion__chev { transition-property: rotate; transition-duration: 200ms; }
.dw-accordion--open .dw-accordion__chev { rotate: 180deg; }

.dw-tiny__bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
.dw-tiny__glow1 { position: absolute; left: -120px; top: -100px; width: 420px; height: 420px; }
.dw-tiny__glow2 { position: absolute; right: -120px; bottom: -120px; width: 380px; height: 380px; }
.dw-tiny__host { font-size: 24px; -unity-font-style: bold; -unity-text-align: upper-center; margin-bottom: var(--sp-2); }
.dw-tiny__headline { font-size: 28px; -unity-font-style: bold; -unity-text-align: upper-center; margin-bottom: var(--sp-4); }
.dw-tiny__intro { font-size: 16px; -unity-text-align: upper-center; margin-bottom: var(--sp-5); }
.dw-tiny__open { height: 54px; border-radius: var(--rad-lg); justify-content: center; margin-bottom: var(--sp-5); transition-property: scale; transition-duration: 120ms; }
.dw-tiny__open:active { scale: 0.97 0.97; }
.dw-tiny__opentext { font-size: 16px; -unity-font-style: bold; margin-left: var(--sp-2); }
.dw-tiny__card { border-radius: var(--rad-lg); border-width: 1px; padding: var(--sp-4); margin-bottom: var(--sp-4); }
.dw-tiny__badge { align-self: flex-start; font-size: 10px; -unity-font-style: bold; letter-spacing: 1px; padding: var(--sp-1) var(--sp-2) var(--sp-1) var(--sp-2); border-radius: var(--rad-xs); }
.dw-tiny__tiertitle { font-size: 18px; -unity-font-style: bold; margin-bottom: var(--sp-3); }
.dw-tiny__item { margin-bottom: var(--sp-2); }
.dw-tiny__dot { width: 6px; height: 6px; border-radius: var(--rad-full); margin: var(--sp-2) var(--sp-2) 0 0; flex-shrink: 0; }
.dw-skeleton { min-height: 44px; border-radius: var(--rad-md); opacity: 0.55; }
.dw-tiny__itemtext { font-size: 14px; }
.dw-tiny__howtitle { font-size: 20px; -unity-font-style: bold; margin-bottom: var(--sp-4); }
.dw-tiny__step { margin-bottom: var(--sp-3); align-items: flex-start; }
.dw-tiny__num { width: 32px; height: 32px; border-radius: var(--rad-lg); -unity-text-align: middle-center; -unity-font-style: bold; font-size: 14px; margin-right: var(--sp-3); flex-shrink: 0; }
.dw-tiny__steptext { font-size: 15px; padding-top: var(--sp-1); }

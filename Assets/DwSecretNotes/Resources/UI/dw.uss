.dw-root { flex-grow: 1; font-size: 15px; -unity-text-generator: advanced; }
.dw-root Label { white-space: normal; }
.dw-aurora { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
.dw-aurora__blob { position: absolute; left: 0; top: 0; }
.dw-safe { flex-grow: 1; }
.dw-pagehost { flex-grow: 1; }
.dw-page { flex-grow: 1; transition-property: opacity, translate; transition-duration: 320ms, 320ms; transition-timing-function: ease-out-cubic, ease-out-cubic; }
.dw-enter { opacity: 0; translate: 0 18px; }
.dw-section { transition-property: opacity, translate; transition-duration: 300ms; transition-timing-function: ease-out-cubic; }
.dw-fade-out { opacity: 0; }
.dw-hero__ad { transition-property: opacity; transition-duration: 300ms; min-height: 42px; }
.dw-row { flex-direction: row; align-items: center; }
.dw-rtl .dw-row { flex-direction: row-reverse; }
.dw-rtl Label { -unity-text-align: upper-right; }
.dw-col { flex-direction: column; }
.dw-scroll { flex-grow: 1; }
.dw-scroll__content { padding: 16px 16px 28px 16px; }
.dw-gap-row > * { margin-right: 10px; }
.dw-gap-row > *:last-child { margin-right: 0; }
.dw-rtl .dw-gap-row > * { margin-right: 0; margin-left: 10px; }
.dw-rtl .dw-gap-row > *:last-child { margin-left: 0; }

.dw-topbar { height: 60px; padding: 0 8px 0 8px; border-bottom-width: 1px; flex-shrink: 0; }
.dw-topbar__logo { width: 34px; height: 34px; border-radius: 10px; margin: 0 10px 0 6px; -unity-background-scale-mode: scale-to-fit; }
.dw-topbar__title { font-size: 19px; -unity-font-style: bold; -unity-text-overflow-position: end; text-overflow: ellipsis; white-space: nowrap; overflow: hidden; }
.dw-iconbtn { width: 44px; height: 44px; border-radius: 22px; align-items: center; justify-content: center; transition-property: background-color, scale; transition-duration: 150ms; }
.dw-iconbtn:hover { background-color: rgba(255,255,255,0.06); }
.dw-iconbtn:active { scale: 0.9 0.9; background-color: rgba(255,255,255,0.12); }

.dw-h1 { font-size: 26px; -unity-font-style: bold; }
.dw-h2 { font-size: 20px; -unity-font-style: bold; }
.dw-title { font-size: 17px; -unity-font-style: bold; }
.dw-body { font-size: 15px; }
.dw-small { font-size: 13px; }
.dw-caption { font-size: 12px; -unity-text-align: upper-center; }
.dw-bold { -unity-font-style: bold; }
.dw-overline { font-size: 11px; -unity-font-style: bold; letter-spacing: 1.5px; margin-bottom: 4px; }
.dw-label { font-size: 14px; -unity-font-style: bold; }
.dw-link { font-size: 14px; -unity-text-align: upper-center; margin-bottom: 2px; }
.dw-secret { font-size: 18px; margin-bottom: 10px; }

.dw-card { border-radius: 20px; border-width: 1px; padding: 16px; }
.dw-hero { padding: 16px; }
.dw-hero__badge { width: 64px; height: 64px; border-radius: 20px; border-width: 1px; align-items: center; justify-content: center; margin-right: 14px; flex-shrink: 0; }
.dw-rtl .dw-hero__badge { margin-right: 0; margin-left: 14px; }
.dw-hero__glow { position: absolute; left: -30px; top: -30px; width: 124px; height: 124px; }

.dw-tabs { height: 52px; border-radius: 26px; border-width: 1px; padding: 4px; }
.dw-tabs__indicator { position: absolute; top: 4px; bottom: 4px; left: 4px; width: 50%; border-radius: 22px; transition-property: translate; transition-duration: 280ms; transition-timing-function: ease-out-back; }
.dw-tabs__indicator--right { translate: 96% 0; }
.dw-rtl .dw-tabs__indicator { translate: 96% 0; }
.dw-rtl .dw-tabs__indicator--right { translate: 0 0; }
.dw-tab { flex-grow: 1; flex-basis: 0; height: 100%; justify-content: center; border-radius: 22px; }
.dw-tab__text { font-size: 15px; -unity-font-style: bold; margin-left: 8px; }
.dw-rtl .dw-tab__text { margin-left: 0; margin-right: 8px; }

.dw-btn { height: 50px; border-radius: 16px; padding: 0 18px 0 18px; justify-content: center; border-width: 1px; transition-property: scale, opacity; transition-duration: 120ms, 200ms; -unity-background-scale-mode: stretch-to-fill; overflow: hidden; flex-shrink: 0; }
.dw-btn:hover { opacity: 0.94; }
.dw-btn:active { scale: 0.97 0.97; }
.dw-btn:disabled { opacity: 0.38; }
.dw-btn--busy { opacity: 0.85; }
.dw-btn--lg { height: 56px; border-radius: 18px; }
.dw-btn--square { width: 50px; padding: 0; }
.dw-btn__text { font-size: 16px; -unity-font-style: bold; margin-left: 8px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; flex-shrink: 1; }
.dw-rtl .dw-btn__text { margin-left: 0; margin-right: 8px; }
.dw-btn > Spinner, .dw-btn > .dw-icon { flex-shrink: 0; }

.dw-field { border-radius: 16px; border-width: 1px; min-height: 52px; padding: 4px 6px 4px 6px; transition-property: border-color; transition-duration: 200ms; }
.dw-field--focus { border-width: 2px; padding: 3px 5px 3px 5px; }
.dw-field__input { margin: 0; flex-grow: 1; }
.dw-field__input > .unity-base-text-field__input, .dw-field__input .unity-base-text-field__input { background-color: rgba(0,0,0,0); border-width: 0; padding: 10px 8px 10px 8px; font-size: 16px; min-height: 40px; }
.dw-field__input--multi .unity-base-text-field__input { max-height: 150px; white-space: normal; }
.dw-field__input--multi TextElement { white-space: normal; }
.dw-field__placeholder { position: absolute; left: 14px; right: 14px; top: 14px; font-size: 16px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }

.dw-attachrow > .dw-btn { margin-right: 10px; }
.dw-attachrow > .dw-btn:last-child { margin-right: 0; }
.dw-thumb { width: 56px; height: 56px; flex-shrink: 0; margin-left: 10px; transition-property: opacity, translate; transition-duration: 250ms; }
.dw-thumb__img { width: 56px; height: 56px; border-radius: 12px; -unity-background-scale-mode: scale-and-crop; }
.dw-thumb__remove { position: absolute; right: -6px; top: -6px; width: 22px; height: 22px; border-radius: 11px; align-items: center; justify-content: center; }

.dw-banner { border-radius: 14px; border-width: 1px; padding: 10px 12px 10px 12px; transition-property: opacity, translate; transition-duration: 250ms; }
.dw-banner__text { font-size: 14px; margin-left: 10px; flex-shrink: 1; }
.dw-rtl .dw-banner__text { margin-left: 0; margin-right: 10px; }
.dw-linkpill { border-radius: 14px; border-width: 1px; padding: 12px; }
.dw-linkpill__text { font-size: 14px; margin-left: 8px; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
.dw-divider { height: 1px; margin: 12px 0 12px 0; flex-shrink: 0; }
.dw-decimage { border-radius: 14px; height: 220px; -unity-background-scale-mode: scale-to-fit; margin-bottom: 4px; display: none; }
.dw-ring__value { font-size: 17px; -unity-font-style: bold; -unity-text-align: middle-center; }

.dw-footer { align-items: center; padding: 8px 0 8px 0; }
.dw-footer__rate { align-items: center; }
.dw-stars { margin-top: 4px; }
.dw-star { margin: 0 2px 0 2px; transition-property: scale; transition-duration: 120ms; }
.dw-star:active { scale: 1.25 1.25; }

.dw-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.dw-scrim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; transition-property: opacity; transition-duration: 240ms; }
.dw-scrim--hidden { opacity: 0; }
.dw-sheethost { position: absolute; left: 0; right: 0; bottom: 0; top: 0; justify-content: flex-end; }
.dw-dialoghost { position: absolute; left: 0; right: 0; bottom: 0; top: 0; justify-content: center; align-items: center; padding: 24px; }
.dw-sheet { border-top-left-radius: 26px; border-top-right-radius: 26px; padding: 10px 18px 26px 18px; max-height: 85%; transition-property: translate, opacity; transition-duration: 280ms; transition-timing-function: ease-out-cubic; }
.dw-sheet__handle { width: 40px; height: 4px; border-radius: 2px; align-self: center; margin-bottom: 14px; }
.dw-sheet__scroll { max-height: 520px; flex-shrink: 1; }
.dw-dialog { border-radius: 24px; border-width: 1px; padding: 22px; width: 100%; max-width: 440px; transition-property: scale, opacity; transition-duration: 220ms; transition-timing-function: ease-out-back; }
.dw-dialog__actions { justify-content: flex-end; }
.dw-dialog__actions > .dw-btn { margin-left: 8px; }
.dw-panel--hidden { opacity: 0; }
.dw-sheet.dw-panel--hidden { translate: 0 100%; }
.dw-dialog.dw-panel--hidden { scale: 0.92 0.92; }
.dw-viewer { position: absolute; left: -24px; right: -24px; top: -24px; bottom: -24px; padding: 0; border-radius: 0; max-width: none; border-width: 0; }
.dw-viewer__img { flex-grow: 1; -unity-background-scale-mode: scale-to-fit; margin: 24px; }
.dw-viewer__close { position: absolute; right: 36px; top: 48px; background-color: rgba(0,0,0,0.35); }
.dw-menuitem { height: 54px; padding: 0 8px 0 8px; border-radius: 14px; }
.dw-menuitem:hover { background-color: rgba(255,255,255,0.05); }
.dw-menuitem:active { background-color: rgba(255,255,255,0.1); }
.dw-menuitem__text { font-size: 16px; margin-left: 16px; }
.dw-rtl .dw-menuitem__text { margin-left: 0; margin-right: 16px; }
.dw-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.dw-swatch { width: 48.5%; margin-bottom: 10px; border-radius: 14px; border-width: 1px; overflow: hidden; transition-property: scale; transition-duration: 120ms; }
.dw-swatch:active { scale: 0.96 0.96; }
.dw-swatch--selected { border-width: 2px; }
.dw-swatch__bar { height: 38px; }
.dw-swatch__label { padding: 10px; }

.dw-toasthost { position: absolute; left: 16px; right: 16px; bottom: 24px; align-items: center; }
.dw-toast { border-radius: 16px; border-width: 1px; padding: 12px 18px 12px 18px; max-width: 520px; transition-property: opacity, translate; transition-duration: 260ms; transition-timing-function: ease-out-cubic; }
.dw-toast--hidden { opacity: 0; translate: 0 20px; }
.dw-toast__text { font-size: 14px; }

.dw-pagehead { padding: 28px 20px 12px 20px; flex-shrink: 0; }
.dw-welcome__logo { width: 76px; height: 76px; border-radius: 22px; margin-bottom: 16px; -unity-background-scale-mode: scale-to-fit; }
.dw-infohead { align-items: center; padding-top: 8px; }
.dw-langitem { border-radius: 16px; border-width: 1px; padding: 14px 16px 14px 16px; margin-bottom: 8px; transition-property: scale, background-color; transition-duration: 140ms; }
.dw-langitem:active { scale: 0.98 0.98; }
.dw-bottombar { padding: 12px 16px 16px 16px; flex-shrink: 0; }
.dw-inforow { padding: 2px 0 2px 0; }
.dw-accordion__body { display: none; margin-top: 10px; }
.dw-accordion--open .dw-accordion__body { display: flex; }
.dw-accordion__chev { transition-property: rotate; transition-duration: 200ms; }
.dw-accordion--open .dw-accordion__chev { rotate: 45deg; }

.dw-tiny__bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: stretch-to-fill; }
.dw-tiny__glow1 { position: absolute; left: -120px; top: -100px; width: 420px; height: 420px; }
.dw-tiny__glow2 { position: absolute; right: -120px; bottom: -120px; width: 380px; height: 380px; }
.dw-tiny__host { font-size: 24px; -unity-font-style: bold; -unity-text-align: upper-center; margin-bottom: 8px; }
.dw-tiny__headline { font-size: 28px; -unity-font-style: bold; -unity-text-align: upper-center; margin-bottom: 16px; }
.dw-tiny__intro { font-size: 16px; -unity-text-align: upper-center; margin-bottom: 24px; }
.dw-tiny__open { height: 54px; border-radius: 14px; justify-content: center; margin-bottom: 28px; transition-property: scale; transition-duration: 120ms; }
.dw-tiny__open:active { scale: 0.97 0.97; }
.dw-tiny__opentext { font-size: 16px; -unity-font-style: bold; margin-left: 8px; }
.dw-tiny__card { border-radius: 16px; border-width: 1px; padding: 20px; margin-bottom: 16px; }
.dw-tiny__badge { align-self: flex-start; font-size: 10px; -unity-font-style: bold; letter-spacing: 1px; padding: 4px 8px 4px 8px; border-radius: 4px; }
.dw-tiny__tiertitle { font-size: 18px; -unity-font-style: bold; margin-bottom: 12px; }
.dw-tiny__item { margin-bottom: 7px; }
.dw-tiny__dot { width: 6px; height: 6px; border-radius: 3px; margin: 7px 10px 0 0; flex-shrink: 0; }
.dw-tiny__itemtext { font-size: 14px; }
.dw-tiny__howtitle { font-size: 20px; -unity-font-style: bold; margin-bottom: 16px; }
.dw-tiny__step { margin-bottom: 12px; align-items: flex-start; }
.dw-tiny__num { width: 32px; height: 32px; border-radius: 16px; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 14px; margin-right: 12px; flex-shrink: 0; }
.dw-tiny__steptext { font-size: 15px; padding-top: 5px; }
